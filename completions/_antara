#compdef antara

# zsh completion for antara CLI
# Install: copy to a directory in $fpath, or run `deno task install:zsh-completions`

_antara() {
  local -a commands=(
    'log:Log a completion or duration for an activity'
    'create:Create a new activity'
    'edit:Edit an existing activity'
    'status:Show progress for all activities'
    'errand:Manage one-off errands'
  )

  local -a errand_commands=(
    'add:Add a new errand'
    'done:Mark an errand as complete'
  )

  # Resolve cache file path — keep in sync with getCachePath() in src/cli/completions.ts
  local cache_file
  if [[ "$OSTYPE" == linux* ]]; then
    cache_file="${XDG_DATA_HOME:-$HOME/.local/share}/antara/completions-cache"
  else
    cache_file="$HOME/.antara/completions-cache"
  fi

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show this help.]' \
    '(-V --version)'{-V,--version}'[Show the version number for this program.]' \
    '1:command:->command' \
    '*::arg:->args'

  case "$state" in
    command)
      _describe 'command' commands
      ;;
    args)
      case "${words[1]}" in
        log)
          if [[ -f "$cache_file" ]]; then
            local -a activities
            activities=("${(@f)$(< "$cache_file")}")
            _describe 'activity' activities
          fi
          ;;
        errand)
          _describe 'command' errand_commands
          ;;
      esac
      ;;
  esac
}

_antara "$@"
